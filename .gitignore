# ═══════════════════════════════════════════════════════════════════════════
# .gitignore - Photo Classification Project
# Keep: Source code, configs, documentation
# Ignore: Build artifacts, data, cache, media files
# ═══════════════════════════════════════════════════════════════════════════

# ── Python 캐시 & 환경 ───────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv*/
*.egg-info/
.eggs/

# ── OS / 에디터 ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.claude/
.cache/

# ── IDE & 개발 도구 ──────────────────────────────────────────────────────────
.env
.env.local
*.code-workspace

# ── 빌드 결과물 (Nuitka, PyInstaller 등) ─────────────────────────────────────
dist/
build/
*.dist/
app.build/
*.spec

# ── 데이터 & 미디어 (git에 올리지 않음) ──────────────────────────────────────
# 설명: 대용량 데이터, 비용 민감 정보, 개인 미디어 파일

# 지리 데이터 (원본 다운로드 필요)
Natural Earth_10m_admin_0_countries/
cities1000.txt
assets/

# 바이너리 도구 (직접 설치 필요)
exiftool.exe
exiftool-*/

# 테스트 & 출력 데이터
other/
test_images/
logs/
output/
models/

# ── 파이프라인 중간 산출물 ───────────────────────────────────────────────────
# 설명: 재생성 가능한 파일들 (민감 정보 포함 가능)
pipeline_*.csv
pipeline_*.db
*_latest.csv
*_latest.db
reclassified_*.csv
reclassified_*.db
reindex_*.csv
root_recursive_*.csv
move_plan*.csv
classified_output/

# ── 라이브 사진 변환 출력 ────────────────────────────────────────────────────
# 설명: 변환된 이미지 (원본에서 재생성 가능)
LivePhotoConverter/test_output*/
PhotoClassifier_Release/
PhotoClassifier_Release_cmd/
PhotoTagging_QWEN2.5VL/

# ── 데이터베이스 ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── 임시 파일 ────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.backup
*.docx
*.xlsx
*.pyd
*.dll
*.so
nuitka-crash-report.xml

# ── 미디어 원본 파일 (대용량) ────────────────────────────────────────────────
# 설명: 모든 미디어 파일 - git에서 제외 (LFS 사용 권장)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.ico

# 비디오
*.mov
*.mp4
*.m4v
*.avi
*.mkv
*.flv
*.wmv
*.3gp
*.m3u8

# 원본 사진 형식
*.heic
*.heif
*.dng
*.tif
*.tiff
*.raw
*.arw
*.cr2
*.crw
*.nef
*.orf
*.raf
*.rw2
*.dsc
*.srw
*.pef
*.iiq
*.x3f

# ── macOS 특화 ───────────────────────────────────────────────────────────────
.AppleDouble
.LSOverride
._*
.apdisk

# ── Windows 특화 ─────────────────────────────────────────────────────────────
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ═══════════════════════════════════════════════════════════════════════════
# 보존 파일 (반드시 git에 커밋)
# ═══════════════════════════════════════════════════════════════════════════
# ✓ 소스 코드 (*.py)
# ✓ 설정 파일 (setup.py, requirements.txt, .gitignore)
# ✓ 문서 (*.md, *.txt)
# ✓ 라이선스 (LICENSE)
# ✓ LivePhotoConverter 소스 코드 (core, cli, ui)
# ✓ 테스트 스크립트 (test_*.py)
